SUBGATE_PANEL_URL=https://panel.example.com
SUBGATE_PANEL_TOKEN=replace-with-a-scoped-remnawave-api-token
SUBGATE_PUBLIC_URL=https://subgate.example.com
# Optional comma-separated CIDRs of proxies you control. Empty means no trust.
SUBGATE_TRUSTED_PROXIES=
SUBGATE_ADMIN_USERNAME=admin
# At least 12 characters; applied only when creating the first administrator.
SUBGATE_ADMIN_PASSWORD=replace-with-a-long-unique-password
# Used by the optional Caddy TLS profile.
SUBGATE_DOMAIN=subgate.example.com

# Host loopback port for an existing reverse proxy.
SUBGATE_CORE_PORT=8080
# Optional Telegram alerts: bot token and comma-separated numeric chat ids.
SUBGATE_TELEGRAM_TOKEN=
SUBGATE_TELEGRAM_CHAT_IDS=
# Optional bearer token for Prometheus scraping of /metrics (otherwise owner login is required).
SUBGATE_METRICS_TOKEN=
