# Place in an existing nginx HTTPS configuration after installing certificates.
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name subgate.example.com;
    ssl_certificate /etc/letsencrypt/live/subgate.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/subgate.example.com/privkey.pem;
    client_max_body_size 2m;
    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_buffering off; # SSE live stream
        proxy_read_timeout 60s;
        proxy_send_timeout 35s;
    }
}
