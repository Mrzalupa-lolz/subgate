# YAML settings are loaded instead of environment settings when -config is used.
http:
  listen: 127.0.0.1:8080
  public_url: https://subgate.example.com
  trusted_proxies: []
  # For a trusted host nginx: [127.0.0.1/32, '::1/128']
  tls:
    enabled: false
database:
  url: file:/var/lib/subgate/subgate.db
  backup_path: /var/lib/subgate/backups
panel:
  # Keep false for the production read-only token. Enable only for a panel
  # where writes are explicitly authorized (development: isolated test panel).
  allow_writes: false
  url: https://panel.example.com
  api_token: replace-with-a-scoped-remnawave-api-token
  # See docs/ARCHITECTURE.md for middleware/routing topology.
  timeout: 15s
  sync_interval: 1m
  webhook_path: /webhook/panel
  webhook_key: replace-with-a-separate-webhook-secret
auth:
  admin_username: admin
  admin_password: replace-with-a-long-unique-password
  session_timeout: 24h
  login_rate_limit: 5
storage:
  activity_journal:
    hot_ttl: 336h
# Optional local JSON prefix dataset, a .mmdb file, or a directory of *.mmdb.
# ipintel:
#   data_path: /var/lib/subgate/prefixes.json
