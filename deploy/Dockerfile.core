# syntax=docker/dockerfile:1
FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG TARGETOS=linux
ARG TARGETARCH
ARG VERSION=0.2.0
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -trimpath -ldflags "-s -w -X main.version=${VERSION}" -o /out/subgate-core ./core/cmd

FROM alpine:3.23
RUN apk add --no-cache ca-certificates && addgroup -S -g 10001 subgate && adduser -S -D -H -u 10001 -G subgate subgate && mkdir -p /data && chown subgate:subgate /data
COPY --from=build /out/subgate-core /usr/local/bin/subgate-core
USER 10001:10001
WORKDIR /data
ENV SUBGATE_LISTEN=:8080 SUBGATE_DATABASE_URL=file:/data/subgate.db SUBGATE_BACKUP_PATH=/data/backups
EXPOSE 8080
VOLUME ["/data"]
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 CMD wget -q -O /dev/null http://127.0.0.1:8080/health || exit 1
ENTRYPOINT ["/usr/local/bin/subgate-core"]
