[Unit]
Description=SubGate node telemetry agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=subgate-agent
Group=subgate-agent
WorkingDirectory=/var/lib/subgate-agent
EnvironmentFile=/etc/subgate/agent.env
ExecStart=/usr/local/bin/subgate-agent -core-addr ${SUBGATE_CORE_URL} -node-id ${NODE_ID} -token-file /var/lib/subgate-agent/token -spool-file /var/lib/subgate-agent/pending.sgb -stats-addr ${XRAY_STATS_ADDR} -access-log ${XRAY_ACCESS_LOG}
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
StateDirectory=subgate-agent
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/subgate-agent
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
LockPersonality=true

[Install]
WantedBy=multi-user.target
