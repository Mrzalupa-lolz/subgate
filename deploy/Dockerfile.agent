# syntax=docker/dockerfile:1
FROM golang:1.26-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ARG TARGETOS=linux
ARG TARGETARCH
ARG VERSION=0.2.0
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -trimpath -ldflags "-s -w -X main.version=${VERSION}" -o /out/subgate-agent ./agent/cmd

FROM alpine:3.23
RUN apk add --no-cache ca-certificates && addgroup -S -g 10001 subgate && adduser -S -D -H -u 10001 -G subgate subgate && mkdir -p /data && chown subgate:subgate /data
COPY --from=build /out/subgate-agent /usr/local/bin/subgate-agent
USER 10001:10001
WORKDIR /data
VOLUME ["/data"]
ENTRYPOINT ["/usr/local/bin/subgate-agent"]
