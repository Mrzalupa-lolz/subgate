{
  "remarks": "WARP",
  "log": {
    "loglevel": "warning"
  },
  "dns": {
    "servers": [
      "1.1.1.1",
      "2606:4700:4700::1111"
    ]
  },
  "inbounds": [
    {
      "tag": "socks-in",
      "listen": "127.0.0.1",
      "port": 10808,
      "protocol": "socks",
      "settings": {
        "auth": "noauth",
        "udp": true
      },
      "sniffing": {
        "enabled": true,
        "destOverride": [
          "http",
          "tls"
        ]
      }
    },
    {
      "tag": "http-in",
      "listen": "127.0.0.1",
      "port": 10809,
      "protocol": "http",
      "settings": {}
    }
  ],
  "outbounds": [
    {
      "tag": "warp",
      "protocol": "wireguard",
      "settings": {
        "secretKey": "SYNTHETIC_PRIVATE_KEY_DO_NOT_USE",
        "address": [
          "172.16.0.2/32",
          "2001:db8::2/128"
        ],
        "mtu": 1280,
        "peers": [
          {
            "publicKey": "SYNTHETIC_PUBLIC_KEY",
            "endpoint": "192.0.2.1:500",
            "keepAlive": 5,
            "allowedIPs": [
              "0.0.0.0/0",
              "::/0"
            ]
          }
        ]
      },
      "streamSettings": {
        "sockopt": {
          "dialerProxy": "noise-out"
        }
      }
    },
    {
      "tag": "noise-out",
      "protocol": "freedom",
      "settings": {
        "domainStrategy": "AsIs",
        "noises": [
          {
            "type": "hex",
            "packet": "",
            "delay": "1-2"
          },
          {
            "type": "rand",
            "packet": "23-911",
            "delay": "1-3"
          },
          {
            "type": "rand",
            "packet": "23-911",
            "delay": "1-3"
          },
          {
            "type": "rand",
            "packet": "23-911",
            "delay": "1-3"
          },
          {
            "type": "rand",
            "packet": "23-911",
            "delay": "1-3"
          },
          {
            "type": "rand",
            "packet": "23-911",
            "delay": "1-3"
          },
          {
            "type": "rand",
            "packet": "23-911",
            "delay": "1-3"
          },
          {
            "type": "rand",
            "packet": "23-911",
            "delay": "1-3"
          },
          {
            "type": "rand",
            "packet": "23-911",
            "delay": "1-3"
          }
        ]
      }
    }
  ],
  "routing": {
    "domainStrategy": "AsIs",
    "rules": [
      {
        "type": "field",
        "network": "tcp,udp",
        "outboundTag": "warp"
      }
    ]
  },
  "futureExtension": {
    "integer": 900719925474099312345,
    "decimal": 1.234567890123456789e+123,
    "values": [
      null,
      false,
      "<opaque>"
    ]
  }
}