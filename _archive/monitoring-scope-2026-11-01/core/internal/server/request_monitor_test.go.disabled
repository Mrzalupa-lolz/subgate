package server

import (
	"encoding/json"
	"fmt"
	"net/http"
	"net/http/httptest"
	"testing"

	"github.com/subgate/subgate/core/internal/requestmonitor"
)

func TestRequestSignalsNeverRestrictSubscriptions(t *testing.T) {
	s := newTestServer(t)
	s.config.Demo = false
	upstream := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		_, _ = w.Write([]byte("subscription"))
	}))
	defer upstream.Close()
	s.gateway.Configure(upstream.URL, s)
	// Legacy rules must not silently retain an access gate after upgrading.
	if err := s.saveObject("geo-rules", "old-deny", map[string]any{"enabled": true, "rule_type": "cidr", "action": "deny", "values": []string{"192.0.2.0/24"}}); err != nil {
		t.Fatal(err)
	}
	for i := 0; i < 105; i++ {
		r := httptest.NewRequest("GET", fmt.Sprintf("http://console.test/sub/test-%d", i), nil)
		r.RemoteAddr = "192.0.2.1:1234"
		r.Header.Set("User-Agent", "sqlmap")
		w := httptest.NewRecorder()
		s.Handler().ServeHTTP(w, r)
		if w.Code != http.StatusOK || w.Body.String() != "subscription" {
			t.Fatalf("request %d restricted: %d %s", i, w.Code, w.Body)
		}
	}
	if w := perform(s, "GET", "/api/v1/request-signals", nil, nil, "", false); w.Code != http.StatusUnauthorized {
		t.Fatalf("anonymous observations: %d", w.Code)
	}
	cookie := loginTest(t, s)
	w := perform(s, "GET", "/api/v1/request-signals", nil, cookie, "", false)
	var result struct {
		Data []requestmonitor.Signal `json:"data"`
	}
	if err := json.Unmarshal(w.Body.Bytes(), &result); err != nil || w.Code != 200 || len(result.Data) != 3 {
		t.Fatalf("observations: %d %s (%v)", w.Code, w.Body, err)
	}
	for _, signal := range result.Data {
		if signal.SourceIP != "192.0.2.1" || signal.Count <= signal.Threshold || signal.WindowSeconds != 60 {
			t.Fatalf("missing evidence: %+v", signal)
		}
	}
	for _, method := range []string{"GET", "PUT", "DELETE"} {
		path := "/api/v1/geo-rules"
		if method != "GET" {
			path += "/old-deny"
		}
		if w := perform(s, method, path, nil, cookie, "", true); w.Code != 404 {
			t.Fatalf("retired geo endpoint: %s %d", method, w.Code)
		}
	}
}
