package requestmonitor

import (
	"fmt"
	"testing"
	"time"
)

func TestOrdinaryClientsAndWindowReset(t *testing.T) {
	m := New()
	for _, ua := range []string{"curl/8", "wget", "Go-http-client/1.1", "python-requests", "Mozilla/5.0"} {
		m.Observe("192.0.2.1", "same", ua)
	}
	if got := m.Signals(); len(got) != 0 {
		t.Fatal(got)
	}
	m.ips["192.0.2.1"].start = time.Now().Add(-2 * time.Minute)
	m.Observe("192.0.2.1", "other", "curl")
	if a := m.ips["192.0.2.1"]; a.requests != 1 || len(a.uuids) != 1 {
		t.Fatal(a)
	}
}

func TestObservationsAreBoundedAndExpire(t *testing.T) {
	m := New()
	m.Observe("old", "uuid", "sqlmap")
	m.ips["old"].last = time.Now().Add(-time.Hour)
	for i := 0; i < maxIPs; i++ {
		m.Observe(fmt.Sprint(i), "uuid", "curl")
	}
	if len(m.ips) != maxIPs || m.ips["old"] != nil {
		t.Fatal("oldest IP not evicted")
	}
	m.Observe("recent", "uuid", "sqlmap")
	a := m.ips["recent"]
	signal := a.signals["scanner_user_agent"]
	signal.LastSeen = time.Now().Add(-25 * time.Hour)
	a.signals["scanner_user_agent"] = signal
	if got := m.Signals(); len(got) != 0 {
		t.Fatal(got)
	}
}
